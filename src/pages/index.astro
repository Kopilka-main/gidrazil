---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ГИДРАЗИЛ — детейлинг-студия в Москве</title>
<meta name="description" content="Гидразил — премиум-детейлинг: тонировка, оклейка плёнкой, полировка, химчистка, реставрация салона. Запись и консъерж-сервис в пределах ТТК." />
<link rel="icon" type="image/png" href={`${base}/assets/img/favicon.png`} />
<link rel="apple-touch-icon" href={`${base}/assets/img/apple-touch-icon.png`} />
<link rel="stylesheet" href={`${base}/assets/css/styles.css`} />
</head>
<body>

<!-- ─────────────────────────  HEADER  ───────────────────────── -->
<header class="site-header">
  <div class="shell-wide row">
    <a class="logo" href={`${base}/`} aria-label="Гидразил — на главную">
      <img class="logo-emblem" src={`${base}/assets/img/logo-mark.png`} alt="" aria-hidden="true" />
      гидразил
    </a>

    <nav class="main-nav" aria-label="Основная навигация">
      <a href="#about">о нас</a>
      <a href="#services">услуги</a>
      <a href="#pricing">цены</a>
      <a href="#works">наши работы</a>
    </nav>

    <div class="header-actions">
      <a class="phone-link" href="tel:+79995516777">
        <span class="dot" aria-hidden="true"></span>
        +7 999 551 6777
      </a>
      <a class="btn btn-primary btn-sm arrow-after" href="#contacts">Контакты</a>
    </div>
  </div>
</header>

<!-- ─────────────────────────  HERO  ───────────────────────── -->
<section class="hero" id="hero" data-hero>
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="shell-wide hero-inner">
    <div class="hero-text">
      <h1 class="hero-wordmark reveal" data-reveal="0">ГИДРАЗИЛ</h1>
      <div class="hero-slogan reveal" data-reveal="1">Искусство превосходства</div>

      <p class="hero-do reveal" data-reveal="2">
        Делаем <span class="hero-rotate" data-rotate aria-live="polite">мойку</span>
      </p>

      <div class="hero-cta reveal" data-reveal="3">
        <a class="btn btn-accent btn-lg arrow-after" href="#contacts">Связаться</a>
        <a class="btn btn-ghost btn-lg" href="#pricing">Рассчитать стоимость</a>
      </div>
    </div>

    <div class="hero-art reveal" data-reveal="1">
      <img class="hero-logo-mark"
           src={`${base}/assets/img/logo-mark.png`} alt="Гидразил — эмблема студии" />
    </div>
  </div>
</section>

<!-- ─────────────────────────  О НАС  ───────────────────────── -->
<section class="block about-block" id="about">
  <div class="shell-wide">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">О студии <span class="dot">·</span> <span class="accent">Гидразил</span></div>
        <h2>О нас</h2>
      </div>
    </div>
    <p class="about-text reveal" data-reveal="0">
      Гидразил — студия детейлинга, где автомобиль получает профессиональный уход,
      внимание к каждой детали и бережное отношение на каждом этапе работы.
      Мы только открываемся, и уже строим работу на качестве, честном подходе
      и современном понимании детейлинга как комплекса услуг по уходу, восстановлению
      и защите автомобиля.
    </p>
  </div>
</section>

<!-- ─────────────────────────  PROMO CAROUSEL  ───────────────────────── -->
<section class="block" id="promo">
  <div class="shell-wide">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">Акции <span class="dot">·</span> Спецпредложения <span class="dot">·</span> <span class="accent">Лето–осень 2026</span></div>
        <h2>Сезонные предложения<br />на ближайший месяц</h2>
      </div>
      <div class="right">
        <button class="icon-btn" data-prev aria-label="Назад">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 L4 8 L10 13" /></svg>
        </button>
        <button class="icon-btn" data-next aria-label="Вперёд">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3 L12 8 L6 13" /></svg>
        </button>
      </div>
    </div>

    <div class="carousel" data-carousel>
      <div class="carousel-track-wrap">
        <div class="carousel-track" role="region" aria-label="Акции"></div>
      </div>
      <div class="carousel-ctrls">
        <div class="carousel-dots" role="tablist"></div>
        <span class="caption">Свайп / стрелки <span style="font-family:var(--mono);color:var(--text-3)">← →</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────  SERVICES  ───────────────────────── -->
<section class="block tight" id="services">
  <div class="shell-wide">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">Услуги <span class="dot">·</span> <span class="accent">11 направлений</span></div>
        <h2>Что мы умеем</h2>
        <p class="lede">Откройте плитку, чтобы прочитать, что входит в услугу.</p>
      </div>
      <div class="right">
        <a class="btn btn-ghost arrow-after" href="#pricing">Открыть прайс</a>
      </div>
    </div>

    <div class="services-grid" data-services-grid></div>
  </div>
</section>

<!-- ─────────────────────────  PRICING  ───────────────────────── -->
<section class="block" id="pricing" style="background:var(--surface-2)">
  <div class="shell-wide">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">Прайс <span class="dot">·</span> <span class="accent">Москва 2026</span></div>
        <h2>Стоимость <br />по вашей машине</h2>
        <p class="lede">Выберите марку, модель, категорию автомобиля и услугу — увидите цены из прайс-листа. Чекбоксами набирайте корзину, она пересчитывает итог.</p>
      </div>
    </div>

    <div class="price-shell" data-pricing>

      <div class="price-step">
        <div class="step-head">
          <span class="step-num">01</span>
          <span class="step-title">Марка авто</span>
          <span class="step-current" data-current-brand></span>
        </div>
        <div class="brand-grid" data-brands></div>
      </div>

      <div class="price-step">
        <div class="step-head">
          <span class="step-num">02</span>
          <span class="step-title">Модель</span>
          <span class="step-current" data-current-model></span>
        </div>
        <div class="model-row" data-models></div>
      </div>

      <div class="price-step">
        <div class="step-head">
          <span class="step-num">03</span>
          <span class="step-title">Категория автомобиля</span>
          <span class="step-current" data-current-category></span>
        </div>
        <div class="model-row" data-price-categories></div>
      </div>

      <div class="price-step">
        <div class="step-head">
          <span class="step-num">04</span>
          <span class="step-title">Услуга</span>
          <span class="step-current" data-current-svc></span>
        </div>
        <div class="service-tabs" data-svc-tabs></div>
        <div data-table style="margin-top:14px"></div>

        <div class="price-foot">
          <div class="total">
            Итого по корзине: <b data-total>0 ₽</b>
          </div>
          <div style="display:flex;gap:12px">
            <a class="btn btn-ghost" href="#contacts">Уточнить цену</a>
            <a class="btn btn-accent arrow-after" href="#contacts">Обсудить услугу</a>
          </div>
        </div>
      </div>

    </div>

    <p class="body-sm" style="margin-top:18px;max-width:680px">
      <span class="mono">Класс 1</span> — обычные автомобили. <span class="mono">Класс 2</span> — 7-местные автомобили (GLS, X7, Range Rover и подобные) и автобусы.
      Если цена для выбранного класса не указана в прайсе, калькулятор покажет «Уточнить».
    </p>
  </div>
</section>

<!-- ─────────────────────────  WORKS  ───────────────────────── -->
<section class="block" id="works">
  <div class="shell-wide">
    <div class="section-head">
      <div class="left">
        <div class="eyebrow">Наши работы <span class="dot">·</span> <span class="accent">реальные фото</span></div>
        <h2>До <span style="font-family:var(--mono);font-size:0.7em;letter-spacing:-0.02em;color:var(--text-2);font-weight:400">→</span> после</h2>
      </div>
      <div class="right">
        <a class="btn btn-ghost arrow-after" href="https://t.me/HydraZIL" target="_blank" rel="noopener">Прислать своё авто</a>
      </div>
    </div>

    <div class="works-grid" data-works></div>
  </div>
</section>

<!-- ─────────────────────────  FOOTER  ───────────────────────── -->
<footer class="site-footer" id="contacts">
  <div class="shell-wide">
    <div class="grid">
      <div>
        <a class="logo" href="#">
          <img class="logo-emblem" src={`${base}/assets/img/logo-mark.png`} alt="" aria-hidden="true" />
          гидразил
        </a>
        <p class="body-sm" style="color:rgba(244,243,239,0.6);max-width:36ch;margin-top:18px">
          Студия детейлинга в Москве. Бережный уход, восстановление и защита автомобиля.
        </p>
      </div>

      <div>
        <h4>Контакты</h4>
        <ul>
          <li class="contact-line"><a href="tel:+79995516777">+7 999 551 6777</a></li>
          <li><a href="mailto:info@hydrazil.ru">info@hydrazil.ru</a></li>
          <li style="font-family:var(--mono);font-size:13px;color:rgba(244,243,239,0.6);margin-top:8px">Ежедневно, круглосуточно</li>
        </ul>
      </div>

      <div>
        <h4>Мессенджеры</h4>
        <ul>
          <li>МАХ: <span style="font-family:var(--mono)">+7 910 113 77 26</span></li>
          <li>Telegram: <a href="https://t.me/HydraZIL" target="_blank" rel="noopener" style="font-family:var(--mono)">@HydraZIL</a></li>
          <li>WhatsApp: <span style="font-family:var(--mono)">+7 999 551 6777</span></li>
        </ul>
      </div>

      <div>
        <h4>Где мы</h4>
        <div class="map">
          <iframe
            title="Карта 2ГИС: Гидразил, бульвар Братьев Весниных, 1"
            src="https://makemap.2gis.ru/widget?data=eJw1UF1vmzAU_S_eY1F3-QjFvEVmJWm9DEeV1nTqA4pd6pRgZExTFuW_75quPBj7Hp8PnzMxViqrZKnMUTmr1UDyP2fipl6RnNyq2o1WkYD01vTKuhk_k71pjUX8G0RZ-BIh7rRrPQPuKjFuGMCuEMOGxcAPYpwK5iY8y7IA_r49bNgEvNg2rBBvslzOe1f-BP4oBo0zx0LYrcS7ZAnweKtpecvZ8gNtpBr2VvdOmw7NqtXyCu5XnozCD2hcVmtvzh9xhiK8EyOdRcRA2QmxBx_IbWZT4WZsGNe_7tdvhx8N7GLPOwHfNSe7b4C_-EeE_u9YsX2lPhjyJItRq4a776KbkozHyysM93fdSfVB8hC-vktAms9iJ1_b_1YrozuH9_cGy9dd7ebS45vrNKaURsFicZ3SLLxJnpGvJcnT6PIckGPdV2bQn28_k7Z2JJ-vRhGNM5pGWQKLNCCtx70aTZJkAWkapiGumM-YI6YLURVbNG37-1Wp9mmeOjuqyz8Wz6D5"
            width="100%"
            height="260"
            frameborder="0"
            sandbox="allow-modals allow-forms allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation">
          </iframe>
        </div>
        <a class="map-link" href="https://2gis.ru/moscow/firm/70000001042927902" target="_blank" rel="noopener">Бульвар Братьев Весниных, 1 · открыть в 2ГИС</a>
        <p class="map-note">−1 этаж · заезд через КПП</p>
      </div>
    </div>

    <div class="bottom">
      <span>© <span data-year></span> гидразил · все права защищены</span>
      <span>ОГРН 1207700000000 · ИНН 7700000000</span>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ base }}>window.SITE_BASE = base;</script>
<script is:inline src={`${base}/assets/js/data.js`}></script>
<script is:inline src={`${base}/assets/js/main.js`}></script>
<script is:inline type="text/javascript" src="https://w2666148.yclients.ru/widgetJS" charset="UTF-8"></script>
</body>
</html>
